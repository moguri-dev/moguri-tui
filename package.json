{
  "name": "@moguri-dev/tui",
  "version": "0.32.0-alpha.7",
  "description": "The Moguri terminal UI and the moguri command-line interface.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moguri-dev/moguri-tui.git"
  },
  "homepage": "https://github.com/moguri-dev/moguri-tui#readme",
  "bugs": {
    "url": "https://github.com/moguri-dev/moguri-tui/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "moguri": "bin/moguri.mjs"
  },
  "exports": {
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "docs/third-party.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/tui/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit tests/*.test.ts",
    "start": "node scripts/launch.mjs tui",
    "dev:tui": "node --import tsx apps/tui/src/main.tsx",
    "cli": "node dist/cli.mjs",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@moguri-dev/sdk": "0.32.0-alpha.7",
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "react": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "node": "26.12.0",
    "node-pty": "1.2.0-beta.18",
    "spdx-license-list": "6.12.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node@26.12.0": true,
    "node-pty@1.2.0-beta.18": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false,
    "pnpm@12.14.0": false,
    "@moguri-dev/sdk": true
  }
}
