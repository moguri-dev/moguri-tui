    "docs/architecture/terminal-reattachment.md",
    "docs/architecture/remote-mcp.md",
    "docs/architecture/remote-console-primitives.md",
    "docs/architecture/remote-user-consoles.md",
    "docs/architecture/remote-github-metadata.md",
    "docs/architecture/remote-repository-memory.md",
    "docs/architecture/compound-routing-primitives.md",
