  "engines": {
    "node": ">=26.4.0 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/prepare-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/tui/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "verify:update": "node --import tsx scripts/verify-update-package.mjs",
    "spike": "node scripts/prepare-native.mjs && node scripts/spikes.mjs",
    "spike:workspace": "node scripts/workspace-spikes.mjs",
    "spike:sessions": "node scripts/session-spikes.mjs",
    "spike:models": "node scripts/model-controls-spike.mjs",
    "spike:engagement": "node scripts/engagement-spikes.mjs",
    "spike:runtime": "node scripts/runtime-spikes.mjs",
    "qualify:ds4": "node scripts/qualify-ds4.mjs",
    "spike:remote": "node scripts/remote-spike.mjs",
    "spike:worktrees": "node scripts/worktree-spike.mjs",
    "spike:documents": "node --import tsx scripts/document-spike.mjs",
    "spike:otel": "node --import tsx scripts/otel-spike.ts",
    "spike:worker-image": "node scripts/prepare-worker-image.mjs --build",
    "prepare:sandbox": "npm run build && node scripts/prepare-sandbox-distribution.mjs",
    "start": "node scripts/launch.mjs tui",
    "desktop": "node scripts/launch.mjs desktop",
    "service": "node --import tsx apps/service/src/main.ts",
    "dev:tui": "node --import tsx apps/tui/src/main.tsx",
    "cli": "node dist/cli.mjs",
    "package:mac": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
