{
  "name": "moguri",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A local-first AI coding workspace for terminal and desktop",
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/prepare-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/tui/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "spike": "node scripts/prepare-native.mjs && node scripts/spikes.mjs",
    "start": "node scripts/launch.mjs tui",
    "desktop": "node scripts/launch.mjs desktop",
    "service": "node --import tsx apps/service/src/main.ts",
    "dev:tui": "node --import tsx apps/tui/src/main.tsx",
    "package:mac": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@napi-rs/keyring": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "node": "26.12.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "dist/desktop/main.mjs",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node@26.12.0": true,
    "node-pty@1.1.0": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false
  }
}
